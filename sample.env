# Copy to .env and fill in. .env is gitignored — never commit real values.
# APP_ENV distinguishes laptop vs deployed (Fargate/App Runner) — Temporal Cloud, real AWS DynamoDB, and Lambda sandbox apply in both. No local Temporal server, no DynamoDB Local (CLAUDE.md §2, §5).

APP_ENV=local                          # local | cloud

# --- Temporal (Temporal Cloud only — never a local server, see CLAUDE.md §2) ---
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TASK_QUEUE=agent-job-queue
TEMPORAL_CLOUD_API_KEY=

# --- AWS ---
AWS_REGION=us-west-2
AWS_PROFILE=

# --- Bedrock models (registry by name, see §4) ---
# Cross-region inference profile IDs (us. prefix) — check with:
#   aws bedrock list-inference-profiles --region <region>
BEDROCK_CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_NOVA_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_API_KEY=

# --- AgentCore ---
AGENTCORE_GATEWAY_URL=
AGENTCORE_MEMORY_ID=
AGENTCORE_RUNTIME_ENDPOINT=            # hosted-agent lane (VendorCheck)

# --- DynamoDB (App database, real AWS in every environment, see §5) ---
DYNAMODB_TABLE_NAME=agent-control-plane

# --- S3 (External Storage claim-check, Preview) ---
S3_BUCKET_NAME=

# --- Mockoon (mocked third-party services, see §5 Mocked services) ---
MOCKOON_BASE_URL=http://localhost:3001 # local: standalone mockoon-cli; cloud: internal Fargate service DNS

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# Worker Deployment Version — bump whenever workflow behaviour changes (proof 2)
BUILD_ID=v1
